# npm run setup creates a local .env.local with a random auth secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Optional: a Neon PostgreSQL connection string. Unset = local PGlite.
# DATABASE_URL=

# Optional: configure both fields in a pair to enable that sign-in provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: text replies without an API bill. Use either local or cloudflare.
# AGENT_TEXT_PROVIDER=local
# LOCAL_AI_PORT=11434
# LOCAL_AI_MODEL=qwen2.5:0.5b
# For cloudflare, keep the account on Workers Free.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_AI_TOKEN=

# Optional: Stream video preview for active meetings.
# NEXT_PUBLIC_STREAM_VIDEO_API_KEY=
# STREAM_VIDEO_SECRET_KEY=
